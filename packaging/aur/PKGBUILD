# Maintainer: Matthias R. Wiora <matthias@wiora.io>
pkgname=tpm2-kira
pkgver=0.0.0
# pkgver may not contain '-', but a prerelease tag can. Keep them separate.
_tag="v$pkgver"
pkgrel=1
pkgdesc="TPM2-based TOTP authenticator with PCR policies"
arch=('x86_64')
url="https://github.com/mrwiora/tpm2-kira"
license=('BSD-3-Clause')
depends=('glibc')
makedepends=('go>=1.24')
optdepends=('mkinitcpio: for early boot integration'
            'cryptsetup: for disk encryption integration'
            'qrencode: renders the enrolment QR code during setup'
            'tpm2-tools: for debugging and integration testing')
conflicts=('tpm2-kira-git')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$_tag.tar.gz")
sha256sums=('SKIP')
options=('!debug')

# GitHub names the extracted directory after the tag, minus a leading 'v'.
_srcdir="$pkgname-${_tag#v}"

prepare() {
    cd "$_srcdir"

    export GOPROXY=direct
    go mod download
}

build() {
    cd "$_srcdir"

    # Deliberately not the usual Arch Go recipe. This binary is copied into the
    # initramfs by the mkinitcpio install hook, which runs before any filesystem
    # but the initramfs itself exists, so it must need neither a shared library
    # nor the dynamic loader.
    #
    #   CGO_ENABLED=0   the standard library otherwise uses cgo for host lookups,
    #                   and internal/pcsc imports net, so a machine with a C
    #                   compiler would produce a binary linked against libc.
    #   no -buildmode=pie  a static PIE has no NEEDED entries but still carries a
    #                   PT_INTERP, so it depends on /lib64/ld-linux-x86-64.so.2
    #                   being present in the image. The ASLR that buys is worth
    #                   less here than not depending on the loader at all.
    #
    # The CGO_* flag exports the guidelines suggest are omitted for the same
    # reason: there is no cgo to pass them to.
    export CGO_ENABLED=0
    export GOFLAGS="-trimpath -mod=readonly -modcacherw"

    go build -ldflags "-s -w -X main.Version=${pkgver}" -o "$pkgname" .

    # The contract above is worth checking rather than assuming.
    if readelf -d "$pkgname" | grep -q NEEDED; then
        echo "PKGBUILD: $pkgname links shared libraries; it must be static" >&2
        return 1
    fi
    if readelf -l "$pkgname" | grep -q interpreter; then
        echo "PKGBUILD: $pkgname needs a dynamic loader; it must be static" >&2
        return 1
    fi
}

check() {
    cd "$_srcdir"

    go test -tags=unit ./...
}

package() {
    cd "$_srcdir"

    install -Dm755 "$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

    # The README defers to these for the detail, so they have to travel with it.
    install -dm755 "$pkgdir/usr/share/doc/$pkgname/docs"
    install -Dm644 docs/*.md "$pkgdir/usr/share/doc/$pkgname/docs/"
    install -Dm644 HISTORY.md "$pkgdir/usr/share/doc/$pkgname/HISTORY.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    # Not enabled on the host: the mkinitcpio install hook enables it inside the
    # image, which is the only place it is meant to run.
    install -Dm644 initramfs/systemd/tpm2-kira.service \
        "$pkgdir/usr/lib/systemd/system/tpm2-kira.service"

    install -Dm644 initramfs/mkinitcpio/install/sd-tpm2-kira \
        "$pkgdir/usr/lib/initcpio/install/sd-tpm2-kira"
    install -Dm755 initramfs/mkinitcpio/post/sd-tpm2-kira \
        "$pkgdir/usr/lib/initcpio/post/sd-tpm2-kira"

    install -Dm644 initramfs/mkinitcpio/mkinitcpio.conf.example \
        "$pkgdir/usr/share/doc/$pkgname/mkinitcpio.conf.example"
}

# vim:set ts=4 sw=4 et:

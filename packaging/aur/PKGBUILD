# Maintainer: Matthias R. Wiora <matthias@wiora.io>
pkgname=tpm2-kira
# The release tag, and its pacman form: pkgver may not contain '-', so a
# prerelease tag's "-rc1" becomes "rc1" (pacman sorts 0.5.0rc1 before
# 0.5.0, as a prerelease must). Set both for a release.
_tag=v0.5.0-rc1
pkgver=0.5.0rc1
pkgrel=1
pkgdesc="TPM2-based TOTP authenticator with PCR policies"
arch=('x86_64')
url="https://github.com/mrwiora/tpm2-kira"
license=('BSD-3-Clause')
# Statically linked, no cgo: the same binary runs in the initramfs.
depends=()
# go.mod's go line is the minimum; the release build sets GOTOOLCHAIN to
# the current Go release, which go fetches when the installed one is older.
makedepends=('go')
optdepends=('mkinitcpio: for early boot integration'
            'cryptsetup: for disk encryption integration'
            'tpm2-tools: for debugging and integration testing'
            'pcsclite: keeping the signing key on a YubiKey (setup --yubikey)')
conflicts=('tpm2-kira-git')
# The commit of the assh submodule at the tag (git rev-parse "$_tag:assh"):
# GitHub's tag tarball leaves submodules out. Set with _tag.
_assh=0ce851719c1aa432e84c125e2389438d55140243
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$_tag.tar.gz")
source+=("assh-$_assh.tar.gz::https://github.com/tpm2-trust/assh/archive/$_assh.tar.gz")
sha256sums=('SKIP' 'SKIP')
options=('!debug')

# GitHub names the extracted directory after the tag, minus a leading 'v'.
_srcdir="$pkgname-${_tag#v}"

prepare() {
    # aSSH's sources where the submodule goes (an archive of the
    # repository's HEAD carries them already, and has no assh-* source).
    if [[ -d assh-$_assh ]]; then
        rm -rf "$_srcdir/assh"
        mv "assh-$_assh" "$_srcdir/assh"
    fi

    cd "$_srcdir"

    export GOPROXY=direct
    go mod download
}

build() {
    cd "$_srcdir"

    # The binary is copied into the initramfs, which has no libc, so it must
    # be fully static. That rules out cgo, which Go enables by default when a
    # C compiler is present (the net package alone then links glibc), and it
    # rules out -buildmode=pie: even without cgo a PIE binary still needs
    # glibc's program interpreter, /lib64/ld-linux-x86-64.so.2, to start.
    export CGO_ENABLED=0
    # The sources are a tarball; a git repository around the build
    # directory (build/aur in a checkout) is not theirs, and Go would stamp
    # its HEAD into the binary. The version is main.Version.
    export GOFLAGS="-trimpath -mod=readonly -modcacherw -buildvcs=false"

    go build -ldflags "-s -w -X main.Version=${pkgver}" -o "$pkgname" .
    go version -m "$pkgname" | grep -q 'CGO_ENABLED=0' || { echo "$pkgname was built with cgo" >&2; return 1; }
}

check() {
    cd "$_srcdir"

    go test -tags=unit ./cmd/...
}

backup=(etc/tpm2-kira/control.conf)

package() {
    cd "$_srcdir"

    install -Dm755 "$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    # Not enabled on the host: the mkinitcpio install hook enables it inside the
    # image, which is the only place it is meant to run.
    install -Dm644 initramfs/systemd/tpm2-kira.service \
        "$pkgdir/usr/lib/systemd/system/tpm2-kira.service"
    install -Dm644 initramfs/systemd/tpm2-kira-cap.service \
        "$pkgdir/usr/lib/systemd/system/tpm2-kira-cap.service"
    install -Dm644 initramfs/systemd/tpm2-kira-unlock.socket \
        "$pkgdir/usr/lib/systemd/system/tpm2-kira-unlock.socket"

    # The attestation by phone; added to the image by the install hook
    # when a phone is enrolled.
    install -Dm644 initramfs/systemd/tpm2-kira-attest.service \
        "$pkgdir/usr/lib/systemd/system/tpm2-kira-attest.service"
    # tpm2-kira's configuration file: the radio, the image's network and
    # SSH server (control writes it, and assh.conf beside it).
    install -Dm644 initramfs/common/control.conf \
        "$pkgdir/etc/tpm2-kira/control.conf"

    install -Dm644 initramfs/mkinitcpio/install/sd-tpm2-kira \
        "$pkgdir/usr/lib/initcpio/install/sd-tpm2-kira"
    install -Dm755 initramfs/mkinitcpio/post/sd-tpm2-kira \
        "$pkgdir/usr/lib/initcpio/post/sd-tpm2-kira"

    install -Dm644 initramfs/mkinitcpio/mkinitcpio.conf.example \
        "$pkgdir/usr/share/doc/$pkgname/mkinitcpio.conf.example"
}

# vim:set ts=4 sw=4 et:

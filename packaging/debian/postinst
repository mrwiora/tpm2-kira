#!/bin/bash
# postinst script for tpm2-kira
# This script runs after the package is installed

set -e

# Summary of what this script does:
# 1. Set up proper permissions for TPM device access
# 2. Add user group for TPM access if needed
# 3. Update initramfs if tools are available
# 4. Display post-installation information

case "$1" in
    configure)

        # Update initramfs if update-initramfs is available
        if command -v update-initramfs >/dev/null 2>&1; then
            echo "Updating initramfs..."
            update-initramfs -u -k all || true
        fi

        # Display post-installation information
        echo ""
        echo "tpm2-kira has been installed successfully!"
        echo ""
        echo "Next steps:"
        echo "1. Work with sudo or change to root"
        echo ""
        echo "2. Verify TPM access:"
        echo "   tpm2-kira nvram list"
        echo ""
        echo "3. Seal your first TOTP secret:"
        echo "   tpm2-kira seal --password \"your-secure-password\""
        echo ""
        echo "4. For early boot integration, see the documentation:"
        echo "   /usr/share/doc/tpm2-kira/README.md"
        echo ""
        echo "5. To integrate with initramfs (optional):"
        echo "   - Edit /etc/initramfs-tools/modules and add required TPM modules"
        echo "   - Run: sudo update-initramfs -u"
        echo ""

        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0

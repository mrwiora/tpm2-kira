#!/bin/bash
# prerm script for tpm2-kira
# This script runs before the package is removed

set -e

# Summary of what this script does:
# 1. Stop any running processes that might be using tpm2-kira
# 2. Clean up any temporary files
# 3. Prepare for safe removal

case "$1" in
    remove|upgrade|deconfigure)
        # Kill any running tpm2-kira processes
        if pgrep -f tpm2-kira >/dev/null 2>&1; then
            echo "Stopping tpm2-kira processes..."
            pkill -f tpm2-kira || true
            sleep 1
        fi

        # Clean up any temporary files in /tmp
        rm -f /tmp/tpm2-kira-* 2>/dev/null || true

        # Display removal information
        if [ "$1" = "remove" ]; then
            echo ""
            echo "Preparing to remove tpm2-kira..."
            echo ""
            echo "IMPORTANT: Your sealed TOTP secrets in TPM NVRAM will NOT be removed."
            echo "To completely remove all data, run before uninstalling:"
            echo "  tpm2-kira nvram delete"
            echo ""
            echo "If you plan to reinstall, your secrets will remain accessible."
            echo ""
        fi

        ;;

    failed-upgrade)
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0

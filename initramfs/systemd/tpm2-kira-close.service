[Unit]
Description=tpm2-kira: the SSH CA closed (PCR 15) when the code screen is over
Documentation=file:///usr/share/doc/tpm2-kira/docs/SSH.md
DefaultDependencies=no
# An initrd unit. The package also puts this file on the host, where the
# mkinitcpio hook picks it up from; enabled there by mistake it does nothing.
ConditionPathExists=/etc/initrd-release
# The SSH CA signs only while PCR 15 holds zero (aSSH: the CA's own
# policy). run closes it right after the host key is certified; this unit
# closes it whatever run did - no SSH server in the image, run failed or
# timed out - once the code screen is over (tpm2-kira.service is ready or
# gone), before any volume is opened and anything of the real root runs. An
# extend more is harmless: PCR 15 never goes back. Ahead of every
# systemd-cryptsetup unit (their tpm2-measure-pcr= into PCR 15) and of
# systemd-pcrmachine/pcrfs in the root, so PCR 15 is the same at every boot
# of the same image. cryptsetup-pre.target is passive: pulled in here.
After=tpm2-kira.service
Wants=cryptsetup-pre.target
Before=cryptsetup-pre.target initrd.target initrd-switch-root.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Waits for the TPM itself (30 s at most). A failure is the boot's: the
# image's initrd.target requires this unit, so the boot stops in the
# emergency target rather than run the real root with the SSH CA open.
ExecStart=tpm2-kira-boot close
StandardOutput=journal+console
StandardError=journal+console

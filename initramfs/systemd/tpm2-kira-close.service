[Unit]
Description=tpm2-kira: the boot closed (PCR 15) when the code screen is over
Documentation=file:///usr/share/doc/tpm2-kira/docs/SSH.md
DefaultDependencies=no
# An initrd unit. The package also puts this file on the host, where the
# mkinitcpio hook picks it up from; enabled there by mistake it does nothing.
ConditionPathExists=/etc/initrd-release
# Every slot object (the TOTP key, the sealed machine-id, the boot key,
# the release key) and the SSH CA work only while PCR 15 holds zero (their
# own policies). run closes the boot when the code screen is over; this
# unit closes it whatever run did - run failed or timed out - once the code
# screen is over (tpm2-kira.service is ready or gone), before any volume is
# opened and anything of the real root runs. An extend more is harmless:
# PCR 15 never goes back. Ahead of every
# systemd-cryptsetup unit (their tpm2-measure-pcr= into PCR 15) and of
# systemd-pcrmachine/pcrfs in the root, so PCR 15 is the same at every boot
# of the same image. cryptsetup-pre.target is passive: pulled in here.
After=tpm2-kira.service
Wants=cryptsetup-pre.target
Before=cryptsetup-pre.target initrd.target initrd-switch-root.target
Conflicts=shutdown.target
Before=shutdown.target
# A failure is a hard reboot, as systemd's own measuring units: no shell with
# PCR 15 at zero (the emergency target's), and the reboot starts the PCRs afresh.
# A TPM that stays broken keeps it rebooting; the way out is docs/SSH.md's. The
# failure of a unit that initrd.target requires would start the emergency target;
# this comes first.
FailureAction=reboot-force

[Service]
Type=oneshot
RemainAfterExit=yes
# Waits for the TPM itself (30 s at most) and tries a refused extend once
# more. A failure is the boot's: the machine reboots rather than run the
# real root with the slots and the SSH CA open; the image's initrd.target
# requires this unit as well, so nothing goes on while that happens.
ExecStart=tpm2-kira-boot close
StandardOutput=journal+console
StandardError=journal+console

[Unit]
Description=Starting tpm2-kira
# The resource-managed node: tpm2-kira only sees and flushes its own handles
# there, so it cannot disturb other TPM users in the initrd.
Requires=dev-tpmrm0.device
After=dev-tpmrm0.device
# The measure point: after systemd's enter-initrd phase (PCR 11) and before
# the OS separator extends PCRs 0-7, 9, 12-14. Type=notify: READY is sent once
# the codes for the prompt have been computed in the TPM, so the separator
# waits for that and then leaves the key's policy unsatisfiable until the
# next boot (SECURITY-BACKGROUND.md §5.8).
After=systemd-pcrphase-initrd.service
Before=systemd-pcrosseparator.service
Before=systemd-ask-password-console.service
Conflicts=multi-user.target
DefaultDependencies=no

[Service]
Type=notify
# READY comes right after the code computation; a hung TPM must not hold the
# boot for longer than this.
TimeoutStartSec=60
ExecStart=tpm2-kira run
StandardOutput=tty
StandardError=tty

[Install]
WantedBy=sysinit.target

[Unit]
Description=tpm2-kira code screen and disk unlock
# An initrd unit. The package also puts this file on the host, where the
# mkinitcpio hook picks it up from; enabled there by mistake it does nothing.
ConditionPathExists=/etc/initrd-release
# The TPM is waited for by run itself, at most 5 s, and only when the
# image's boot plan has a part that needs it (the codes, the phone, the
# vault, the SSH CA's host key) - as on Debian. The key provider needs no
# TPM: the prompt is tpm2-kira's on every machine.
# The measure point: after systemd's enter-initrd phase (PCR 11) and before
# the OS separator extends PCRs 0-7, 9, 12-14. Type=notify: a fresh code is
# shown every 30 s until Enter is pressed on the console or the hold (90 s)
# ends; READY is sent then, the separator runs, and the key's policy is
# unsatisfiable until the next boot (SECURITY-BACKGROUND.md §5.8).
After=systemd-pcrphase-initrd.service
Before=systemd-pcrosseparator.service
# systemd 258's NvPCR initialisation separator extends PCR 11 in the
# initrd; unordered it could land while the code is shown and break the
# policy mid-screen. Held back like the OS separator, it is also what the
# key provider waits for before the prompt (run_boot.go, waitPromptTurn).
# Unknown to older systemd, where the ordering is simply ignored.
Before=systemd-pcrnvdone.service
Before=systemd-ask-password-console.service
Conflicts=multi-user.target
# With a phone enrolled, this process is also the coordinator of the
# Bluetooth gate: it starts the radio worker (gate-child, confined by the
# binary itself, as on Debian), holds the TPM for it, and reads the phone's
# receipt itself. The worker ends when the boot is released. The process
# must not stay on the console: StandardInput=tty makes it the terminal's owner,
# and the passphrase prompt waits for the console to be free. (A display
# that goes on for codes that only compute after the separator gives the
# terminal up first.)
Conflicts=initrd-switch-root.target
Before=initrd-switch-root.target
DefaultDependencies=no
# The disk's key: systemd-cryptsetup asks for it on this socket (see the
# socket unit), after the separator. This process answers once the code
# screen is confirmed, at its own passphrase prompt, and stays alive for
# that until switch-root; the console is given up with the hold, so the
# prompt opens /dev/console only while it asks.
Sockets=tpm2-kira-unlock.socket

[Service]
Type=notify
# The stop's SIGTERM goes to run alone, as Debian's init-bottom sends it:
# run tells the SSH sessions that the machine boots, and ssh-child relays
# that before it ends; the radio worker ends with run's service. What is
# left when run has exited is killed.
KillMode=mixed
# The hold is 90 s (tpm2-kira-boot run --hold), plus at most 60 s for a phone
# that is in the middle of its answer; a hung TPM must not hold the boot for
# longer than this. Raise it together with --hold.
TimeoutStartSec=180
# --plan: the parts the image carries (internal/admin/bootplan.go); what is not in it
# is not started. The key socket comes from the socket unit
# (Sockets=), not from a flag. TPM2_KIRA_REMOTE is set by the
# image's drop-in (tpm2-kira.service.d/remote.conf) when control.conf turns
# the SSH server on: --ssh and its hold (the port is assh.conf's); unset,
# it is no argument.
ExecStart=tpm2-kira-boot run --plan /etc/tpm2-kira/plan $TPM2_KIRA_REMOTE
# Enter on the console releases the boot.
StandardInput=tty
StandardOutput=tty
# What the key provider and the phone check report (when a volume asked,
# when the hold ended, when the prompt opened and answered) is written to
# the journal directly, never to the console (the code screen is there);
# the initrd's journald hands it to the system's:
#   journalctl -b -u tpm2-kira.service
# stderr carries failures and warnings, which the console shows as well.
# "Debug at boot" (the boot settings in the TPM, 'tpm2-kira control') puts
# the narrative on the
# console too.
StandardError=journal+console

[Install]
WantedBy=sysinit.target

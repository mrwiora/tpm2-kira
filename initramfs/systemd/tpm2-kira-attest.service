[Unit]
Description=tpm2-kira remote attestation over Bluetooth LE (lazy)
Documentation=https://github.com/mrwiora/tpm2-kira/blob/main/docs/PLAN-BLE.md
DefaultDependencies=no
# An initrd unit. The package also puts this file on the host, where the
# mkinitcpio hook picks it up from; enabled there by mistake it does nothing.
ConditionPathExists=/etc/initrd-release
# The resource-managed node, like the display.
Requires=dev-tpmrm0.device
After=dev-tpmrm0.device
# Started together with the code screen (tpm2-kira.service), not after it: a
# slot enrolled with a phone is verified by the phone while the code is
# shown, and the phone's verdict releases the boot like Enter does. The gate
# keeps asking after that, until the disk is unlocked. Its quotes therefore
# come from before or after systemd-pcrosseparator.service; the phone treats
# both as the same boot (PLAN-BLE.md §3.3). enter-initrd is in PCR 11 by then.
After=systemd-pcrphase-initrd.service
# The image lists the adapter's driver modules in modules-load.d.
After=systemd-modules-load.service
# Started before the prompt, but never waited for: lazy mode must not hold
# the boot. Type=simple returns as soon as the process runs.
Before=systemd-ask-password-console.service
# The adapter is released when the initramfs ends.
Conflicts=initrd-switch-root.target
Before=initrd-switch-root.target

[Service]
Type=simple
ExecStart=/usr/bin/tpm2-kira attest gate --mode lazy
# To the console, where the user is, and to the journal, where the lines
# survive the boot: 'journalctl -b -u tpm2-kira-attest.service' on the
# unlocked system says what the gate did, or why it did nothing.
StandardOutput=journal+console
StandardError=journal+console
# No phone in range (3) is normal in lazy mode. A rejected boot (4) or an
# anchor mismatch (5) is left to fail the unit, so the console shows a red
# FAILED line next to the warning; nothing requires this unit, so the boot
# carries on either way.
SuccessExitStatus=3

# Where the gate tells the code screen its state (one line: waiting, phone
# connected, verdict). Kept after the gate has exited with its verdict.
RuntimeDirectory=tpm2-kira-attest
RuntimeDirectoryPreserve=yes

# Confinement. This process parses radio input from anyone in range, as root,
# before the disk is unlocked. It needs the TPM, one Bluetooth adapter and the
# console, and gets nothing else: should a parsing bug ever be found, this is
# what limits what it can be turned into.
#
# Capabilities: the HCI user channel needs CAP_NET_ADMIN, the raw HCI socket
# CAP_NET_RAW. Nothing else survives, and none can be regained.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=
# Sockets: Bluetooth, and Unix for the console and the TPM's resource manager.
# No IP in any form. (Not PrivateNetwork=: Bluetooth sockets exist only in
# the initial network namespace.)
RestrictAddressFamilies=AF_BLUETOOTH AF_UNIX
IPAddressDeny=any
# Devices: the TPM, rfkill to clear a soft block, the console.
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
DeviceAllow=/dev/tpm0 rw
DeviceAllow=/dev/rfkill rw
DeviceAllow=/dev/console rw
# File system: read-only, /sys and /proc/sys included. The gate only reads
# there (adapter and rfkill state, the event log, the Secure Boot variables).
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
UMask=0077
# Kernel interfaces a Go program talking to a socket and a device never needs.
# An unexpected call fails with EPERM instead of killing the gate.
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=sysinit.target

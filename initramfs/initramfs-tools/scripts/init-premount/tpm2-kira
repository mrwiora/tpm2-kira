#!/bin/sh
# Show the TOTP code before the root filesystem is unlocked.
#
# init-premount runs from /init; local-top/cryptroot runs later, from mountroot.
# That ordering is what puts this output ahead of the passphrase prompt.

set -e

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
prereqs)
    prereqs
    exit 0
    ;;
esac

. /scripts/functions

[ -x /usr/bin/tpm2-kira-boot ] || exit 0

if command -v wait_for_udev >/dev/null 2>&1; then
    wait_for_udev 10
fi

# The parts the image carries (internal/admin/bootplan.go): written by the
# hook, one directory each. run starts what they name, and nothing else -
# the phone's radio worker and the SSH server's unprivileged half are its
# own children - and waits for the TPM itself when a part needs it, as
# under systemd. The adapter's modules are loaded by the image's init
# (the hook's force_load).
PLAN=/etc/tpm2-kira/plan

# The key socket, where the keyscript of crypttab's
# keyscript=/lib/cryptsetup/scripts/tpm2-kira takes the volume's key from
# (under systemd: the socket unit).
mkdir -p -m 700 /run/tpm2-kira
UNLOCK=/run/tpm2-kira/unlock.sock

# The network and the SSH server (docs/SSH.md), written by the plan from
# control.conf only when they are in it.
TPM2_KIRA_NET=off
TPM2_KIRA_REMOTE=
[ -r /etc/tpm2-kira/remote.conf ] && . /etc/tpm2-kira/remote.conf

# tpm2_kira_netdev prints the interface the network is for: the one with
# the MAC or the name TPM2_KIRA_NET_MATCH says, or the first wired one.
tpm2_kira_netdev() {
    for d in /sys/class/net/*; do
        [ -e "$d/device" ] || continue
        case "${TPM2_KIRA_NET_MATCH:-}" in
        *:*)
            [ "$(cat "$d/address" 2>/dev/null)" = "$TPM2_KIRA_NET_MATCH" ] || continue
            ;;
        "")
            [ -e "$d/wireless" ] || [ -e "$d/phy80211" ] && continue
            ;;
        *)
            [ "${d##*/}" = "$TPM2_KIRA_NET_MATCH" ] || continue
            ;;
        esac
        echo "${d##*/}"
        return 0
    done
    return 1
}

# tpm2_kira_net brings the network up, in the background: the code screen
# does not wait for it. DHCP asks as the running system does: with its
# client identifier (TPM2_KIRA_NET_CLIENTID) busybox' udhcpc, without one
# initramfs-tools' own (klibc's ipconfig, as for an NFS root or
# dropbear-initramfs), which sends none. A static address is busybox' ip.
# The interface is noted for init-bottom, which takes it down again.
tpm2_kira_net() {
    # ipconfig fails each try it times out, and a static address may be
    # set already: neither ends the setup.
    set +e
    i=0
    while ! dev=$(tpm2_kira_netdev); do
        if [ "$i" -ge 180 ]; then
            echo "tpm2-kira: network: no interface ${TPM2_KIRA_NET_MATCH:-wired} appeared"
            return 1
        fi
        sleep 1
        i=$((i + 1))
    done
    echo "$dev" > /run/tpm2-kira/net-device
    case "$TPM2_KIRA_NET" in
    dhcp)
        if [ -n "${TPM2_KIRA_NET_CLIENTID:-}" ]; then
            ip link set dev "$dev" up
            until busybox udhcpc -f -q -n -t 5 -T 3 -i "$dev" -s /etc/tpm2-kira/udhcpc.script \
                -x "0x3d:$TPM2_KIRA_NET_CLIENTID"; do
                sleep 1
            done
        else
            unset BOOTIF
            DEVICE=$dev
            IP=dhcp
            configure_networking
        fi
        ;;
    static)
        ip link set dev "$dev" up
        for a in $TPM2_KIRA_NET_ADDRESS; do
            ip address add "$a" dev "$dev"
        done
        for g in $TPM2_KIRA_NET_GATEWAY; do
            case "$g" in
            *:*) ip -6 route add default via "$g" dev "$dev" ;;
            *) ip route add default via "$g" dev "$dev" ;;
            esac
        done
        : > /etc/resolv.conf
        for n in $TPM2_KIRA_NET_DNS; do
            echo "nameserver $n" >> /etc/resolv.conf
        done
        ;;
    esac
    echo "tpm2-kira: network: $TPM2_KIRA_NET on $dev: $(ip -o address show dev "$dev" 2>/dev/null | awk '{print $4}' | tr '\n' ' ')"
}

mkdir -p /run/initramfs

# The slots' records (KIRAslotN) and the sealed machine-id are EFI
# variables, read through efivarfs, which initramfs-tools does not mount
# (systemd does, as an API file system, on Arch). Without it no slot is
# read: the boot goes on to the passphrase prompt.
if [ -d "$PLAN/tpm" ] && [ -d /sys/firmware/efi/efivars ] && ! grep -qs ' /sys/firmware/efi/efivars efivarfs ' /proc/mounts; then
    mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>>/run/initramfs/tpm2-kira.log ||
        echo "tpm2-kira: efivarfs is not mounted: no slot's record can be read" >>/run/initramfs/tpm2-kira.log
fi

# The installed system's machine-id, sealed under slot 0's policy, released
# before the network as under systemd (tpm2-kira-machine-id.service): written
# where the image's /etc/machine-id is. Whatever fails is said, the boot
# goes on.
case "$TPM2_KIRA_NET" in
dhcp | static)
    TPM2_KIRA_LOG=/run/initramfs/tpm2-kira.log /usr/bin/tpm2-kira-boot machine-id 2>>/run/initramfs/tpm2-kira.log
    ;;
esac

# The code screen, the gate's coordinator and the key provider in one
# process; it stays for the keyscript until init-bottom stops it. A
# background job of a non-interactive shell would get /dev/null as stdin;
# Enter at the code screen is read from the console. What it reports
# (stderr: the key requests, the phone) goes to a log that survives into
# the booted system, /run/initramfs/tpm2-kira.log - the journal's part
# under systemd.
mkdir -p /run/initramfs
# TPM2_KIRA_REMOTE (--ssh ...) makes it the SSH server too, as the image's
# /etc/tpm2-kira/assh.conf says.
# shellcheck disable=SC2086
TPM2_KIRA_LOG=/run/initramfs/tpm2-kira.log /usr/bin/tpm2-kira-boot run --plan "$PLAN" --unlock "$UNLOCK" $TPM2_KIRA_REMOTE </dev/console >/dev/console 2>>/run/initramfs/tpm2-kira.log &
echo $! > /run/tpm2-kira.pid

case "$TPM2_KIRA_NET" in
dhcp | static)
    tpm2_kira_net >>/run/initramfs/tpm2-kira.log 2>&1 </dev/null &
    echo $! > /run/tpm2-kira-net.pid
    ;;
esac

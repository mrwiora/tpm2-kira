#!/bin/sh
# Show the TOTP code before the root filesystem is unlocked.
#
# init-premount runs from /init; local-top/cryptroot runs later, from mountroot.
# That ordering is what puts this output ahead of the passphrase prompt.

set -e

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
prereqs)
    prereqs
    exit 0
    ;;
esac

. /scripts/functions

[ -x /usr/bin/tpm2-kira ] || exit 0

if command -v wait_for_udev >/dev/null 2>&1; then
    wait_for_udev 10
fi

# The parts the image carries (cmd/bootplan.go): written by the hook, one
# directory each. The TPM is waited for only when a part needs it; the key
# provider needs none: the prompt is tpm2-kira's on every machine.
PLAN=/etc/tpm2-kira/plan
if [ -d "$PLAN/tpm" ]; then
    # go-tpm opens the resource-manager node directly; no tcti library involved.
    i=0
    while [ ! -c /dev/tpmrm0 ] && [ "$i" -lt 5 ]; do
        sleep 1
        i=$((i + 1))
    done
    if [ ! -c /dev/tpmrm0 ]; then
        log_warning_msg "tpm2-kira: /dev/tpmrm0 did not appear; no code this boot"
    fi
fi

# The two sockets of the display: the gate's, where the radio worker reaches
# the TPM (only with the phone in the plan), and the key socket, where the keyscript of crypttab's
# keyscript=/lib/cryptsetup/scripts/tpm2-kira takes the volume's key from.
mkdir -p -m 700 /run/tpm2-kira
GATE=/run/tpm2-kira/gate.sock
UNLOCK=/run/tpm2-kira/unlock.sock

mode=run
[ -r /etc/tpm2-kira/initramfs.conf ] && . /etc/tpm2-kira/initramfs.conf
mode=${TPM2_KIRA_INITRAMFS_MODE:-run}

# The network and the SSH server (docs/SSH.md), written by the plan from
# control.conf only when they are in it.
TPM2_KIRA_NET=off
TPM2_KIRA_REMOTE=
[ -r /etc/tpm2-kira/remote.conf ] && . /etc/tpm2-kira/remote.conf
[ "$mode" = once ] && TPM2_KIRA_REMOTE=

# tpm2_kira_netdev prints the interface the network is for: the one with
# the MAC or the name TPM2_KIRA_NET_MATCH says, or the first wired one.
tpm2_kira_netdev() {
    for d in /sys/class/net/*; do
        [ -e "$d/device" ] || continue
        case "${TPM2_KIRA_NET_MATCH:-}" in
        *:*)
            [ "$(cat "$d/address" 2>/dev/null)" = "$TPM2_KIRA_NET_MATCH" ] || continue
            ;;
        "")
            [ -e "$d/wireless" ] || [ -e "$d/phy80211" ] && continue
            ;;
        *)
            [ "${d##*/}" = "$TPM2_KIRA_NET_MATCH" ] || continue
            ;;
        esac
        echo "${d##*/}"
        return 0
    done
    return 1
}

# tpm2_kira_net brings the network up, in the background: the code screen
# does not wait for it. DHCP asks as the running system does: with its
# client identifier (TPM2_KIRA_NET_CLIENTID) busybox' udhcpc, without one
# initramfs-tools' own (klibc's ipconfig, as for an NFS root or
# dropbear-initramfs), which sends none. A static address is busybox' ip.
# The interface is noted for init-bottom, which takes it down again.
tpm2_kira_net() {
    # ipconfig fails each try it times out, and a static address may be
    # set already: neither ends the setup.
    set +e
    i=0
    while ! dev=$(tpm2_kira_netdev); do
        if [ "$i" -ge 180 ]; then
            echo "tpm2-kira: network: no interface ${TPM2_KIRA_NET_MATCH:-wired} appeared"
            return 1
        fi
        sleep 1
        i=$((i + 1))
    done
    echo "$dev" > /run/tpm2-kira/net-device
    case "$TPM2_KIRA_NET" in
    dhcp)
        if [ -n "${TPM2_KIRA_NET_CLIENTID:-}" ]; then
            ip link set dev "$dev" up
            until busybox udhcpc -f -q -n -t 5 -T 3 -i "$dev" -s /etc/tpm2-kira/udhcpc.script \
                -x "0x3d:$TPM2_KIRA_NET_CLIENTID"; do
                sleep 1
            done
        else
            unset BOOTIF
            DEVICE=$dev
            IP=dhcp
            configure_networking
        fi
        ;;
    static)
        ip link set dev "$dev" up
        for a in $TPM2_KIRA_NET_ADDRESS; do
            ip address add "$a" dev "$dev"
        done
        for g in $TPM2_KIRA_NET_GATEWAY; do
            case "$g" in
            *:*) ip -6 route add default via "$g" dev "$dev" ;;
            *) ip route add default via "$g" dev "$dev" ;;
            esac
        done
        : > /etc/resolv.conf
        for n in $TPM2_KIRA_NET_DNS; do
            echo "nameserver $n" >> /etc/resolv.conf
        done
        ;;
    esac
    echo "tpm2-kira: network: $TPM2_KIRA_NET on $dev: $(ip -o address show dev "$dev" 2>/dev/null | awk '{print $4}' | tr '\n' ' ')"
}

# Never allow a failure here to abort boot.
case "$mode" in
once)
    [ -d "$PLAN/codes" ] && /usr/bin/tpm2-kira reveal >/dev/console 2>&1 || true
    ;;
*)
    # The code screen, the gate's coordinator and the key provider in one
    # process; it stays for the keyscript until init-bottom stops it.
    # A background job of a non-interactive shell would get /dev/null as
    # stdin; Enter at the code screen is read from the console. What the
    # display reports (stderr: the key requests, the phone) goes to a log
    # that survives into the booted system, /run/initramfs/tpm2-kira.log.
    mkdir -p /run/initramfs
    # TPM2_KIRA_REMOTE (--ssh ...) makes it the SSH server too, as the
    # image's /etc/tpm2-kira/assh.conf says.
    # shellcheck disable=SC2086
    TPM2_KIRA_LOG=/run/initramfs/tpm2-kira.log /usr/bin/tpm2-kira run --plan "$PLAN" --gate "$GATE" --unlock "$UNLOCK" $TPM2_KIRA_REMOTE </dev/console >/dev/console 2>>/run/initramfs/tpm2-kira.log &
    echo $! > /run/tpm2-kira.pid
    ;;
esac

case "$TPM2_KIRA_NET" in
dhcp | static)
    tpm2_kira_net >>/run/initramfs/tpm2-kira.log 2>&1 </dev/null &
    echo $! > /run/tpm2-kira-net.pid
    ;;
esac

# Remote attestation over Bluetooth: the radio worker serves the enrolled
# phone beside the code screen, with the coordinator's TPM. It never holds
# the boot; init-bottom stops it. Only with the phone in the plan.
if [ "$mode" != once ] && [ -d "$PLAN/phone" ] && [ -r /etc/tpm2-kira/bluetooth-modules ]; then
    while read -r m; do
        modprobe -q "$m" || true
    done </etc/tpm2-kira/bluetooth-modules
    # Its narrative goes to the log (TPM2_KIRA_LOG); what needs eyes, to the console.
    TPM2_KIRA_LOG=/run/initramfs/tpm2-kira.log /usr/bin/tpm2-kira phone gate --coordinator "$GATE" >/dev/null 2>/dev/console &
    echo $! > /run/tpm2-kira-attest.pid
fi

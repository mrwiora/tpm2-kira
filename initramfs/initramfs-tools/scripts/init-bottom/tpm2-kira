#!/bin/sh
# Stop run and close the boot (PCR 15: every slot and the SSH CA) before the
# real root takes over: what systemd's stop of tpm2-kira.service and
# tpm2-kira-close.service do in the initrd.
#
# run-init wipes the initramfs, so a process still running from it has to go.

set -e

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
prereqs)
    prereqs
    exit 0
    ;;
esac

# run, which may be the SSH server and the phone's coordinator too: asked
# to stop first, while the network is still up, so the SSH sessions are
# told and its unprivileged half relays that and ends with it (the server
# waits for that up to 3 s); its children end with it. After 5 s it is
# killed.
if [ -r /run/tpm2-kira.pid ]; then
    read -r pid < /run/tpm2-kira.pid
    rm -f /run/tpm2-kira.pid
    if [ -n "$pid" ] && kill -TERM "$pid" 2>/dev/null; then
        i=0
        while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 50 ]; do
            sleep 0.1 2>/dev/null || sleep 1
            i=$((i + 1))
        done
        kill -9 "$pid" 2>/dev/null || true
    fi
fi

# The network's setup, if still at it: nothing to flush or save.
if [ -r /run/tpm2-kira-net.pid ]; then
    read -r pid < /run/tpm2-kira-net.pid
    rm -f /run/tpm2-kira-net.pid
    [ -n "$pid" ] && kill -9 "$pid" 2>/dev/null || true
fi

# The image's network goes down: the running system configures the
# interface itself (ifupdown, NetworkManager), and an address left from
# here would stay beside its own.
if [ -r /run/tpm2-kira/net-device ]; then
    read -r dev < /run/tpm2-kira/net-device
    rm -f /run/tpm2-kira/net-device
    killall -q ipconfig 2>/dev/null || true
    if [ -n "$dev" ] && command -v ip >/dev/null 2>&1; then
        ip address flush dev "$dev" 2>/dev/null || true
        ip route flush dev "$dev" 2>/dev/null || true
        ip link set dev "$dev" down 2>/dev/null || true
    fi
    rm -f "/run/net-$dev.conf"
fi

# Close the boot (PCR 15 extended) whatever run did - run closed it when
# the code screen was over, unless it failed: every slot object's policy
# and the SSH CA's read PCR 15, so nothing in the running system can
# compute a code, open a slot's part or have a key certified. With the TPM
# in the plan (a sealed slot, an SSH CA). Its failure stops the boot: the
# real root must not run with them open. initramfs-tools' panic (a shell on
# the console, or a reboot with panic=); leaving the shell tries the close
# again, never the boot without it.
if [ -d /etc/tpm2-kira/plan/tpm ]; then
    while ! /usr/bin/tpm2-kira-boot close >/dev/console 2>&1; do
        . /scripts/functions
        panic "tpm2-kira: the boot is not closed (PCR 15): the boot does not go on until it is"
    done
fi

exit 0

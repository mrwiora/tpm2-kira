#!/bin/sh
# Stop the background TOTP display and lock code computation before the real
# root takes over.
#
# run-init wipes the initramfs, so a process still running from it has to go.

set -e

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
prereqs)
    prereqs
    exit 0
    ;;
esac

PIDFILE=/run/tpm2-kira.pid

if [ -r "$PIDFILE" ]; then
    read -r pid < "$PIDFILE"
    rm -f "$PIDFILE"

    # Nothing to flush or save, so there is no reason to wait for a graceful exit.
    [ -n "$pid" ] && kill -9 "$pid" 2>/dev/null || true
fi

# Lock code computation until the next boot, so nothing in the running
# system can compute codes. Never let a failure here stop the boot.
[ -x /usr/bin/tpm2-kira ] && /usr/bin/tpm2-kira cap >/dev/console 2>&1 || true

exit 0

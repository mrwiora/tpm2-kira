#!/bin/sh
# Stop the background TOTP display and lock code computation before the real
# root takes over.
#
# run-init wipes the initramfs, so a process still running from it has to go.

set -e

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
prereqs)
    prereqs
    exit 0
    ;;
esac

# The TOTP display and, if enabled, the Bluetooth attestation gate. Neither
# has anything to flush or save, so there is no reason to wait for a graceful
# exit; the kernel releases the adapter when the gate's socket closes.
for PIDFILE in /run/tpm2-kira.pid /run/tpm2-kira-attest.pid; do
    [ -r "$PIDFILE" ] || continue
    read -r pid < "$PIDFILE"
    rm -f "$PIDFILE"
    [ -n "$pid" ] && kill -9 "$pid" 2>/dev/null || true
done

# Lock code computation until the next boot, so nothing in the running
# system can compute codes. Never let a failure here stop the boot.
[ -x /usr/bin/tpm2-kira ] && /usr/bin/tpm2-kira cap >/dev/console 2>&1 || true

exit 0

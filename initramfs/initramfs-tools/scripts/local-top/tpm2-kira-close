#!/bin/sh
# The boot closed (PCR 15 extended: every slot and the SSH CA) right before
# a resume from hibernation: a resume starts the TPM afresh, which sets
# PCR 15 back to zero, and the resumed system runs no code screen. After every volume is
# unlocked (cryptroot), before local-premount, where initramfs-tools
# resumes. In a boot where run closed it already, an extend more changes
# nothing. Anything but PCR 15 itself (no TPM aside) stops the resume; the boot's
# own close, in init-bottom, decides what follows: local-premount/resume reads $resume alone (init made it
# from resume= and noresume once, before any script), and the ORDER file
# sources /conf/param.conf after every script, so an empty resume= there
# reaches it.
#
# The package installs it into every image; it acts only while the image's
# plan has the TPM (a sealed slot, an SSH CA), as init-bottom's close.

PREREQ="cryptroot"

prereqs() {
    echo "$PREREQ"
}

case "$1" in
prereqs)
    prereqs
    exit 0
    ;;
esac

[ -d /etc/tpm2-kira/plan/tpm ] || exit 0
if ! /usr/bin/tpm2-kira-boot close --resume 2>>/run/initramfs/tpm2-kira.log; then
    echo "tpm2-kira: the boot is not closed (PCR 15): no resume from hibernation this boot" >/dev/console
    echo "resume=" >>/conf/param.conf
fi
exit 0

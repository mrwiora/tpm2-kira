#!/bin/sh
# initramfs-tools hook: place tpm2-kira into the initramfs image.
#
# No key material is copied. 'reveal' reads the sealed blob from TPM NVRAM and
# unseals it via the PCR policy branch, so the signing keys stay on the
# encrypted root where they belong.

set -e

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
prereqs)
    prereqs
    exit 0
    ;;
esac

. /usr/share/initramfs-tools/hook-functions

kira=$(command -v tpm2-kira || true)
if [ -z "$kira" ]; then
    echo "tpm2-kira: binary not found in PATH; refusing to build an initramfs" >&2
    echo "tpm2-kira: that silently shows no TOTP code at boot" >&2
    exit 1
fi

copy_exec "$kira" /usr/bin/tpm2-kira

if [ -r /etc/tpm2-kira/initramfs.conf ]; then
    copy_file config /etc/tpm2-kira/initramfs.conf /etc/tpm2-kira/initramfs.conf
fi
# How the disk's key is made (unlock.conf: skip, password+salt, password+remotesalt).
if [ -r /etc/tpm2-kira/unlock.conf ]; then
    copy_file config /etc/tpm2-kira/unlock.conf /etc/tpm2-kira/unlock.conf
    if grep -q '^TPM2_KIRA_UNLOCK=password+remotesalt' /etc/tpm2-kira/unlock.conf; then
        enrolled=$("$kira" attest status --json 2>/dev/null)
        if [ -z "$enrolled" ] || [ "$enrolled" = "[]" ]; then
            echo "tpm2-kira: unlock mode password+remotesalt, but no phone is enrolled: the remote salt is only released by an attestation; every boot will fall back to cryptsetup's own prompt" >&2
        fi
    fi
fi

# Built in on most kernels, but a module on some machines.
manual_add_modules tpm_tis
manual_add_modules tpm_crb

# Bluetooth for remote attestation (PLAN-BLE.md §3.1), whenever a phone is
# enrolled. 'tpm2-kira attest initramfs-deps' names the configured adapter's
# driver modules and the firmware files the kernel loaded for it on this
# machine; nothing else is copied. Without an enrolled phone, or without the
# adapter, the image shows the code and serves the disk's key and asks no
# phone.
attest_conf=/etc/tpm2-kira/attest.conf
TPM2_KIRA_ATTEST_ADAPTER=0
[ -r "$attest_conf" ] && . "$attest_conf"
adapter=${TPM2_KIRA_ATTEST_ADAPTER#hci}
enrolled=$("$kira" attest status --json 2>/dev/null)
if [ -z "$enrolled" ] || [ "$enrolled" = "[]" ]; then
    echo "tpm2-kira: no phone is enrolled; Bluetooth not added"
# The gate checks the enrolment record before it advertises: signed
# by this machine's signing key, and current by the TPM's record
# counter. 'attest signer' prints the key's public half (public, not
# a secret) for the image after checking the records; one written by
# somebody else, or an older one put back, is refused, and then the
# gate is not added.
elif ! signer=$("$kira" attest signer) || ! printf '%s\n' "$signer" | grep -q 'BEGIN PUBLIC KEY'; then
    echo "tpm2-kira: the attestation record was not accepted (see above); Bluetooth not added" >&2
else
    log=$(mktemp)
    journalctl -k -b -o cat >"$log" 2>/dev/null || true
    rc=0
    deps=$("$kira" attest initramfs-deps --adapter "$adapter" --kernel-log "$log") || rc=$?
    rm -f "$log"

    if [ "$rc" -ne 0 ]; then
        echo "tpm2-kira: a phone is enrolled but hci$adapter was not found; Bluetooth not added" >&2
    elif ! printf '%s\n' "$deps" | grep -q '^adapter '; then
        # Every other command exits 0 by design, so a binary that
        # predates initramfs-deps "succeeds" with no output.
        echo "tpm2-kira: the installed tpm2-kira cannot resolve Bluetooth dependencies (too old?); Bluetooth not added" >&2
    else
        mkdir -p "$DESTDIR/etc/tpm2-kira"
        : >"$DESTDIR/etc/tpm2-kira/bluetooth-modules"
        nmod=0
        nfw=0
        # A here-document keeps the loop in this shell, so the
        # counters survive it.
        while read -r kind value; do
            case "$kind" in
            module)
                manual_add_modules "$value"
                echo "$value" >>"$DESTDIR/etc/tpm2-kira/bluetooth-modules"
                nmod=$((nmod + 1))
                ;;
            firmware)
                add_firmware "$value"
                nfw=$((nfw + 1))
                ;;
            warning)
                echo "tpm2-kira: $value" >&2
                ;;
            esac
        done <<DEPS
$deps
DEPS
        [ -r "$attest_conf" ] && copy_file config "$attest_conf" /etc/tpm2-kira/attest.conf
        mkdir -p "$DESTDIR/etc/tpm2-kira"
        printf '%s\n' "$signer" > "$DESTDIR/etc/tpm2-kira/attest-signer.pem"
        echo "tpm2-kira: Bluetooth attestation via hci$adapter: $nmod modules, $nfw firmware files"
    fi
fi

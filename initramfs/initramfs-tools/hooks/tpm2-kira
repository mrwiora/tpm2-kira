#!/bin/sh
# initramfs-tools hook: place tpm2-kira into the initramfs image - the disk
# unlock always, and what the machine uses besides, by the boot plan.
#
# No key material is copied. 'reveal' reads the sealed blob from TPM NVRAM and
# unseals it via the PCR policy branch, so the signing keys stay on the
# encrypted root where they belong.

set -e

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
prereqs)
    prereqs
    exit 0
    ;;
esac

. /usr/share/initramfs-tools/hook-functions

# The binary: the package's in /usr/bin, or make install's in /usr/local/bin,
# which mkinitramfs' PATH (/usr/bin:/sbin:/bin) leaves out. In the image it
# is /usr/bin/tpm2-kira, where the scripts run it.
kira=$(PATH="$PATH:/usr/local/bin" command -v tpm2-kira || true)
if [ -z "$kira" ]; then
    echo "tpm2-kira: the binary is not installed (/usr/bin or /usr/local/bin); refusing to build an initramfs" >&2
    echo "tpm2-kira: that silently shows no TOTP code at boot" >&2
    exit 1
fi

copy_exec "$kira" /usr/bin/tpm2-kira

if [ -r /etc/tpm2-kira/initramfs.conf ]; then
    copy_file config /etc/tpm2-kira/initramfs.conf /etc/tpm2-kira/initramfs.conf
fi
# The devices with a keyslot of tpm2-kira's: does /etc/crypttab route each
# through the keyscript, and if not, what the line should read
# ('tpm2-kira luks route'; it edits nothing).
if advice=$("$kira" luks route 2>&1); then
    [ -n "$advice" ] && echo "tpm2-kira: $advice"
else
    echo "tpm2-kira: the disk's key is not routed through tpm2-kira everywhere - /etc/crypttab is not edited; change it as shown and run update-initramfs -u:" >&2
    echo "$advice" | sed 's/^/    /' >&2
fi

# The boot plan (internal/admin/bootplan.go): what this image carries besides the disk
# unlock, decided by 'tpm2-kira initramfs plan' from what the machine uses -
# the slots in the TPM and what they are enrolled with, the signing key,
# the Bluetooth adapter, the network and SSH settings of
# /etc/tpm2-kira/control.conf. Each part is in only when something uses it,
# and the output says why one is out. The plan writes the image's own
# files (the signing public key, the adapter's module list and udev rule,
# remote.conf, assh.conf and the keys that may log in, udhcpc's script) and
# names its parts in
# /etc/tpm2-kira/plan, which the boot scripts read; this hook adds the
# drivers and firmware it lists. control.conf never goes into the image.
# The network needs busybox (ip, and udhcpc for DHCP with the running
# system's client identifier).
nobusybox=
if [ "${BUSYBOX:-auto}" = n ] || ! command -v busybox >/dev/null 2>&1; then
    nobusybox=--no-busybox
fi
if ! plan=$("$kira" initramfs plan --format initramfs-tools --buildroot "$DESTDIR" $nobusybox); then
    echo "tpm2-kira: the installed tpm2-kira made no boot plan: the image unlocks the disk and carries nothing else" >&2
    exit 0
fi
nbt=0
nfw=0
nnet=""
# A here-document keeps the loop in this shell, so the counters survive it.
while read -r kind value; do
    case "$kind" in
    say) echo "tpm2-kira: $value" ;;
    warning) echo "tpm2-kira: WARNING: $value" >&2 ;;
    bt-module)
        manual_add_modules "$value"
        nbt=$((nbt + 1))
        ;;
    bt-firmware)
        add_firmware "$value"
        nfw=$((nfw + 1))
        ;;
    net-module)
        manual_add_modules "$value"
        nnet="$nnet $value"
        ;;
    net-modules-all) auto_add_modules net ;;
    module) manual_add_modules "$value" ;;
    esac
done <<PLAN
$plan
PLAN

# The TPM's drivers: built in on most kernels, but modules on some machines.
if [ -d "$DESTDIR/etc/tpm2-kira/plan/tpm" ]; then
    manual_add_modules tpm_tis
    manual_add_modules tpm_crb
fi
[ -d "$DESTDIR/etc/tpm2-kira/plan/phone" ] && echo "tpm2-kira: Bluetooth: $nbt modules, $nfw firmware files"
[ -n "$nnet" ] && echo "tpm2-kira: network drivers:$nnet"
exit 0

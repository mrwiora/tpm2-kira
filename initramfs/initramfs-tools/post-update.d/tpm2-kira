#!/bin/sh
# Run by update-initramfs after a new image is written.
#   $1 kernel version   $2 path to the generated initramfs
#
# Reseals so the next boot shows a code. PCR 8 and 9 (GRUB's commands and
# files) are predicted from this boot's event log with what changed on disk
# put in - the initrd just written, a new kernel, grub.cfg - so no boot
# without a code is needed (docs/README.md, "Choosing PCRs on Debian").
# A kernel install runs update-grub after this; the kernel hook
# (/etc/kernel/postinst.d/zzz-tpm2-kira) reseals again then, with the
# final grub.cfg.

set -e

command -v tpm2-kira >/dev/null 2>&1 || exit 0
[ -d /etc/tpm2-kira/keys ] || exit 0
tpm2-kira info --json 2>/dev/null | grep -q '"index"' || exit 0

echo "tpm2-kira: initramfs rebuilt ($1); resealing for the next boot" >&2
# No terminal (setsid): a PIN it cannot read from control.conf ends the
# reseal with the reason instead of a prompt that would hold the update.
setsid -w tpm2-kira reseal </dev/null || echo "tpm2-kira: reseal did not succeed; the next boot shows no code until 'tpm2-kira reseal' does" >&2
exit 0

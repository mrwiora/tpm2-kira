#!/bin/sh
# Run by the kernel package hooks (/etc/kernel/postinst.d, postrm.d) after
# zz-update-grub has written the new grub.cfg: the last word on what GRUB
# will measure at the next boot. Reseals with PCR 8 and 9 predicted from
# this boot's event log and the files on disk (the new kernel, its initrd,
# the menu entries of the new grub.cfg).
#   $1 kernel version   $2 kernel image path

set -e

# make install puts tpm2-kira in /usr/local/bin, which the PATH this runs
# with may leave out.
PATH=$PATH:/usr/local/bin

command -v tpm2-kira >/dev/null 2>&1 || exit 0
[ -d /etc/tpm2-kira/keys ] || exit 0
# Something to reseal: a sealed slot, or the SSH CA (its EFI variable).
tpm2-kira info --json 2>/dev/null | grep -q '"index"' || [ -e /sys/firmware/efi/efivars/KIRAasshCA-24415b90-39be-45c0-a9a3-d547ebe28ea0 ] || exit 0

echo "tpm2-kira: kernel $1 and grub.cfg changed; resealing for the next boot" >&2
# No terminal (setsid): a PIN it cannot read from /etc/tpm2-kira/pin ends the
# reseal with the reason instead of a prompt that would hold the update.
setsid -w tpm2-kira reseal </dev/null || echo "tpm2-kira: reseal did not succeed; the next boot shows no code until 'tpm2-kira reseal' does" >&2
exit 0

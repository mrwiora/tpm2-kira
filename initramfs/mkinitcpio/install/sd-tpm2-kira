#!/bin/bash

# Units that measure into PCRs before tpm2-kira runs. Their presence changes the
# values tpm2-kira must seal against, so the verdict is reported and handed to
# the post hook rather than being guessed at reseal time.
MEASURE_POINT_STATE=/run/tpm2-kira/measure-point.state

_unit_wired() {
    local name=$1
    compgen -G "$BUILDROOT/usr/lib/systemd/system/*.wants/$name" > /dev/null ||
        compgen -G "$BUILDROOT/etc/systemd/system/*.wants/$name" > /dev/null
}

_report_measure_point() {
    local -a active=()
    local unit

    for unit in systemd-pcrosseparator.service systemd-pcrphase-initrd.service; do
        if [[ -e $BUILDROOT/usr/lib/systemd/system/$unit ]]; then
            if _unit_wired "$unit"; then
                active+=("$unit")
            else
                warning "tpm2-kira: $unit is present but not enabled in this initramfs"
            fi
        fi
    done

    mkdir -p "$(dirname "$MEASURE_POINT_STATE")"
    if (( ${#active[@]} > 0 )); then
        printf 'on\n' > "$MEASURE_POINT_STATE"
        plain "tpm2-kira: measure-point units active: ${active[*]}"
        plain "tpm2-kira:   the display runs after enter-initrd (PCR 11) and before the os-separator,"
        plain "tpm2-kira:   which then locks the TOTP secret until the next boot"
    else
        printf 'off\n' > "$MEASURE_POINT_STATE"
        plain "tpm2-kira: no systemd measure-point units in this initramfs; sealing against end-of-firmware values"
    fi
}

CONF=${TPM2_KIRA_CONTROL_CONF:-/etc/tpm2-kira/control.conf}

# The binary: the package's in /usr/bin, or make install's in /usr/local/bin,
# which mkinitcpio's PATH (/usr/bin:/bin) leaves out. In the image it is
# /usr/bin/tpm2-kira, where the units find it.
KIRA=$(PATH=$PATH:/usr/local/bin type -P tpm2-kira)

# A unit of tpm2-kira's. add_systemd_unit adds the binary of each Exec line
# as this machine's PATH finds it, which make install's is not on; build
# has put it into the image already. The rest goes as add_systemd_unit
# has it.
_add_kira_unit() {
    local orig
    orig=$(declare -f add_binary)
    if [[ -z $orig ]]; then
        add_systemd_unit "$1"
        return
    fi
    eval "_kira_$orig"
    add_binary() { [[ $1 == tpm2-kira ]] || _kira_add_binary "$@"; }
    add_systemd_unit "$1"
    eval "$orig"
    unset -f _kira_add_binary
}
PLAN=/etc/tpm2-kira/plan

# The boot plan (cmd/bootplan.go): what this image carries besides the disk
# unlock, decided by 'tpm2-kira initramfs plan' from what the machine uses -
# the slots in the TPM and what they are enrolled with, the signing key,
# the Bluetooth adapter, the network and SSH settings of control.conf.
# Each part is in only when something uses it, and the build output says
# why one is out. The plan writes the image's own files (the signing public
# key, the network file, the sealed SSH host key, the drop-ins) and names
# its parts in $PLAN; this hook adds the units and the drivers it lists.
# control.conf never goes into the image, and this hook does not read it.
# Nothing here stops the build: a part that cannot be had stays out.
_plan_has() {
    [[ -d $BUILDROOT$PLAN/$1 ]]
}

_add_plan() {
    local out kind value nfw=0 adapter
    local -a btmods=() btfw=() netmods=()
    if ! out=$("$KIRA" initramfs plan --format mkinitcpio --conf "$CONF" --buildroot "$BUILDROOT"); then
        warning "tpm2-kira: the installed tpm2-kira made no boot plan: the image unlocks the disk and carries nothing else"
        return 0
    fi
    while read -r kind value; do
        case $kind in
            say) plain "tpm2-kira: $value" ;;
            warning) warning "tpm2-kira: $value" ;;
            bt-module) btmods+=("$value") ;;
            bt-firmware) btfw+=("$value") ;;
            net-module) add_module "$value" && netmods+=("$value") ;;
            net-modules-all) add_checked_modules /drivers/net ;;
            module) add_module "$value" ;;
        esac
    done <<< "$out"

    # The codes: the lock of code computation when the initrd is left, so
    # nothing in the running OS can compute codes until the next boot.
    if _plan_has codes; then
        _add_kira_unit tpm2-kira-cap.service
        add_symlink /usr/lib/systemd/system/sysinit.target.wants/tpm2-kira-cap.service \
            /usr/lib/systemd/system/tpm2-kira-cap.service
    fi

    # The phone's gate (PLAN-BLE.md §3.1): the adapter's driver modules and
    # the firmware the kernel loaded for it on this machine. add_module
    # copies every firmware file a module declares: for btusb's dependencies
    # that is ~60 files for chips this machine does not have. When the
    # kernel log named the files this adapter really loaded, only those go
    # in; otherwise the declarations.
    if _plan_has phone; then
        local saved_add_firmware=''
        if (( ${#btfw[@]} )); then
            saved_add_firmware=$(declare -f add_firmware)
            add_firmware() { return 0; }
        fi
        for value in "${btmods[@]}"; do
            add_module "$value"
        done
        if [[ -n $saved_add_firmware ]]; then
            eval "$saved_add_firmware"
        fi
        for value in "${btfw[@]}"; do
            add_firmware "$value" && nfw=$((nfw + 1))
        done
        _add_kira_unit tpm2-kira-attest.service
        add_symlink /usr/lib/systemd/system/sysinit.target.wants/tpm2-kira-attest.service \
            /usr/lib/systemd/system/tpm2-kira-attest.service
        plain "tpm2-kira: Bluetooth: ${#btmods[@]} modules, $nfw firmware files"
    fi

    # The network: systemd-networkd with its user, from the plan's file
    # alone - /etc/systemd/network is the running system's. The SSH server
    # is tpm2-kira itself ('run' and its unprivileged 'remote serve'): its
    # drop-in is the plan's, nothing more to add.
    if _plan_has net; then
        add_systemd_unit systemd-networkd.service
        add_symlink /usr/lib/systemd/system/sysinit.target.wants/systemd-networkd.service \
            /usr/lib/systemd/system/systemd-networkd.service
        local db
        for db in passwd shadow group; do
            grep '^systemd-network:' "/etc/$db" >> "$BUILDROOT/etc/$db"
        done
        (( ${#netmods[@]} )) && plain "tpm2-kira: network drivers: ${netmods[*]}"
    fi
    return 0
}

UNLOCK_SOCKET=/run/tpm2-kira/unlock.sock

# The disk's unlock goes through tpm2-kira when the volume's key file is
# tpm2-kira's socket: systemd-cryptsetup reads the key from there
# (crypttab(5), "AF_UNIX KEY FILES") and tpm2-kira answers once the code
# screen is confirmed. The key file is named on the kernel command line,
# rd.luks.key=<UUID>=/run/tpm2-kira/unlock.sock, honoured in the initrd
# only (systemd-cryptsetup-generator(8)); or, for a volume kept in
# /etc/crypttab with x-initrd.attach, in that line's key field. This hook
# adds the socket unit and reports what it finds configured: the command
# line of the running system and the files the UKI is built from, and the
# crypttab. Nothing is written.
_add_unlock() {
    local crypttab=${1:-/etc/crypttab}
    shift
    local -a cmdlines=("$@")
    (( ${#cmdlines[@]} )) || cmdlines=(/proc/cmdline /etc/kernel/cmdline /etc/cmdline.d/*.conf)
    local f word uuid name key opts routed=0

    _add_kira_unit tpm2-kira-unlock.socket
    add_symlink /usr/lib/systemd/system/sysinit.target.wants/tpm2-kira-unlock.socket \
        /usr/lib/systemd/system/tpm2-kira-unlock.socket
    # How the disk's key is made is not configured: the key provider reads
    # each volume's LUKS2 header at boot (the tpm2-kira tokens).

    # Is any volume routed through the socket at all (the command line, or
    # an x-initrd.attach line of crypttab)? Said only when none is.
    for f in "${cmdlines[@]}"; do
        [[ -r $f ]] || continue
        for word in $(< "$f"); do
            case $word in
                rd.luks.key=*=$UNLOCK_SOCKET|luks.key=*=$UNLOCK_SOCKET|rd.luks.key=$UNLOCK_SOCKET|luks.key=$UNLOCK_SOCKET)
                    routed=1
                    ;;
            esac
        done
    done
    while read -r name _ key opts; do
        [[ $key == "$UNLOCK_SOCKET" ]] && routed=1
    done < <(awk '!/^\s*($|#)/ && $4 ~ /x-initrd\.attach/' "$crypttab" 2>/dev/null)

    # The devices with a keyslot of tpm2-kira's, one line each: where the
    # key comes from, or what is wrong and what the line should read
    # ('tpm2-kira luks route'; it edits nothing).
    local -a routeargs=()
    for f in "${cmdlines[@]}"; do
        [[ $f == /proc/cmdline ]] && continue
        routeargs+=(--cmdline "$f")
    done
    local advice line
    if advice=$("$KIRA" luks route "${routeargs[@]}" --crypttab "$crypttab" 2>&1); then
        while IFS= read -r line; do [[ -n $line ]] && plain "tpm2-kira: $line"; done <<< "$advice"
    else
        warning "tpm2-kira: the disk's key is not routed through tpm2-kira everywhere - the files below are not edited; change them as shown and rebuild:"
        while IFS= read -r line; do plain "    $line"; done <<< "$advice"
    fi
    if (( ! routed )); then
        warning "tpm2-kira: no volume is unlocked through tpm2-kira yet; add rd.luks.key=<UUID>=$UNLOCK_SOCKET next to rd.luks.name= on the kernel command line (README, \"Configure the disk unlock\")"
    fi
}

build() {
    if [[ -z $KIRA ]]; then
        error "tpm2-kira: the binary is not installed (/usr/bin or /usr/local/bin)"
        return 1
    fi
    add_binary "$KIRA" /usr/bin/tpm2-kira

    # The display and the key provider, enabled in the image only:
    # add_systemd_unit only carries over .wants symlinks that already exist
    # on the host, and the host's own boot stays untouched. It waits for
    # the TPM only when a part of the plan needs it (the plan's drop-in).
    _add_kira_unit tpm2-kira.service
    add_symlink /usr/lib/systemd/system/sysinit.target.wants/tpm2-kira.service \
        /usr/lib/systemd/system/tpm2-kira.service

    _report_measure_point

    _add_unlock

    _add_plan
}

help() {
    cat <<HELPEOF
This hook puts tpm2-kira into a systemd-based initramfs: the disk unlock
always, and what the machine uses besides, by the boot plan
('tpm2-kira initramfs plan', 'tpm2-kira help initramfs').

The hook will:
- Install the tpm2-kira binary into the image, with tpm2-kira.service and
  tpm2-kira-unlock.socket, enabled inside the image only
- Report which volumes are unlocked through tpm2-kira: those whose key
  file is /run/tpm2-kira/unlock.sock (crypttab(5), AF_UNIX key files),
  named on the kernel command line as rd.luks.key=<UUID>=/run/tpm2-kira/unlock.sock
  or in the key field of an x-initrd.attach line of /etc/crypttab.
  systemd-cryptsetup reads the key from tpm2-kira, which makes it as the
  volume's LUKS2 header says. Nothing is written.
- Add each part of the boot plan that something uses, and say why the
  others are out:
    TOTP codes   a slot is sealed: the code screen waits for the TPM, and
                 tpm2-kira-cap.service locks the codes when the initrd is left
    Phone        a phone is enrolled (or TPM2_KIRA_ATTEST_BLUETOOTH=always):
                 the adapter's driver and firmware, the signing public key,
                 tpm2-kira-attest.service
    Vault        a slot is enrolled with a vault, and the image has a network
    Network      TPM2_KIRA_NET in /etc/tpm2-kira/control.conf: systemd-networkd
                 and the matched interface's driver
    SSH server   TPM2_KIRA_SSH=on: tpm2-kira's own, run unprivileged; the
                 host key made in the TPM at boot, certified by the SSH CA
                 of the EFI variable KIRAasshCA (efivarfs)
  A machine without a TPM gets the disk unlock alone.

Post-generation hook (sd-tpm2-kira in /usr/lib/initcpio/post/, or
/etc/initcpio/post/ from make install-mkinitcpio):
  After the initramfs image is written, 'tpm2-kira reseal' is executed
  automatically. This is necessary because the initramfs content is
  measured into PCRs at boot - every rebuild may change the expected
  values, so the sealed TOTP secret must be resealed to match, and the
  SSH CA approved for them.

Prerequisites:
- systemd-based initramfs (mkinitcpio with systemd support, sd-encrypt)
- tpm2-kira binary installed, in /usr/bin or /usr/local/bin

Usage in /etc/mkinitcpio.conf (either order):
  HOOKS=(... sd-tpm2-kira sd-encrypt ...)
and on the kernel command line, next to rd.luks.name=<UUID>=cryptroot:
  rd.luks.key=<UUID>=/run/tpm2-kira/unlock.sock
HELPEOF
}

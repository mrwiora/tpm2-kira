#!/bin/bash
# tpm2-kira post-generation hook for mkinitcpio
#
# This script is executed by mkinitcpio after a new initramfs image has been
# successfully generated.  Because the initramfs content is measured into PCRs
# at boot, every image rebuild potentially changes the expected PCR values.
# We therefore reseal the TOTP secret against the current (post-build) state
# so that the next boot can unseal it via the PCR branch.
#
# Arguments supplied by mkinitcpio:
#   $1 — kernel version
#   $2 — path to the generated initramfs image

KIRA_KEYS_DIR="/var/lib/tpm2-kira/keys"

# Only act when tpm2-kira is installed and has been set up.
if ! command -v tpm2-kira &> /dev/null; then
    exit 0
fi

if [[ ! -d "$KIRA_KEYS_DIR" ]]; then
    # No keys directory means setup has not been run yet; nothing to reseal.
    exit 0
fi

echo "tpm2-kira: resealing TOTP secret after initramfs rebuild..."

# The install hook inspected the image that was just built and recorded whether
# systemd's pre-measure-point units are in it. That describes the NEXT boot,
# which runtime probing cannot do on the boot where the units first appear.
MEASURE_POINT_STATE=/run/tpm2-kira/measure-point.state
measure_point=auto
if [[ -r $MEASURE_POINT_STATE ]]; then
    read -r measure_point < "$MEASURE_POINT_STATE"
    case $measure_point in
        on | off) ;;
        *) measure_point=auto ;;
    esac
fi

# tpm2-kira exits 0 even on failure, by design, so that chained commands still
# run. Success must therefore be judged from the output, not the exit status.
output=$(tpm2-kira reseal --measure-point="$measure_point" 2>&1)
if grep -q "Successfully resealed" <<< "$output"; then
    echo "tpm2-kira: reseal completed successfully (measure-point=$measure_point)"
else
    echo "tpm2-kira: WARNING — reseal did NOT succeed:" >&2
    echo "$output" >&2
    echo "tpm2-kira: the next boot will not be able to unseal; run 'tpm2-kira reseal' manually" >&2
    # Do not fail the overall mkinitcpio run; the image was already written.
fi

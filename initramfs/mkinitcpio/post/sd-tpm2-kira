#!/bin/bash
# tpm2-kira post-generation hook for mkinitcpio
#
# This script is executed by mkinitcpio after a new initramfs image has been
# successfully generated.  Because the initramfs content is measured into PCRs
# at boot, every image rebuild potentially changes the expected PCR values.
# We therefore reseal the TOTP secret against the current (post-build) state
# so that the next boot can unseal it via the PCR branch.
#
# Arguments supplied by mkinitcpio:
#   $1 — kernel version
#   $2 — path to the generated initramfs image

KIRA_KEYS_DIR="/var/lib/tpm2-kira/keys"

# Only act when tpm2-kira is installed and has been set up.
if ! command -v tpm2-kira &> /dev/null; then
    exit 0
fi

if [[ ! -d "$KIRA_KEYS_DIR" ]]; then
    # No keys directory means setup has not been run yet; nothing to reseal.
    exit 0
fi

# Keys can exist with nothing sealed: 'setup' creates the key and 'seal' is a
# separate step. That is not a problem to warn about on every rebuild, so it is
# handled as a skip further down rather than as a failed reseal.

echo "tpm2-kira: resealing TOTP secret after initramfs rebuild..."

# The install hook inspected the image that was just built and recorded whether
# systemd's pre-measure-point units are in it. That describes the NEXT boot,
# which runtime probing cannot do on the boot where the units first appear.
MEASURE_POINT_STATE=/run/tpm2-kira/measure-point.state
measure_point=auto
if [[ -r $MEASURE_POINT_STATE ]]; then
    read -r measure_point < "$MEASURE_POINT_STATE"
    case $measure_point in
        on | off) ;;
        *) measure_point=auto ;;
    esac
fi

# A signing key held in a YubiKey needs a PIN, and this hook has no terminal to
# ask at. The PIN is read from the mkinitcpio configuration, which is the right
# place for it on Arch for one specific reason: mkinitcpio *sources* that file
# at build time and never copies it into the image. Debian's initramfs.conf is
# different — mkinitramfs copies it into the image, which lands on unencrypted
# /boot — so the Debian hook deliberately has no equivalent.
#
# Prefer a drop-in: /etc/mkinitcpio.conf.d/ exists for this, and a file there
# can be mode 0600, whereas /etc/mkinitcpio.conf is world-readable by default.
#
#     # /etc/mkinitcpio.conf.d/tpm2-kira.conf   (chmod 600)
#     TPM2_KIRA_PIN=12345678
#
# Leaving it unset is a legitimate choice: the reseal is then skipped with an
# explanation, and you run it by hand. A slot with PIN policy 'never' needs no
# PIN at all.
_load_pin() {
    local file

    [[ -n ${TPM2_KIRA_PIN:-} ]] && return 0

    for file in /etc/mkinitcpio.conf.d/*.conf /etc/mkinitcpio.conf; do
        [[ -r $file ]] || continue
        grep -qs '^[[:space:]]*\(export[[:space:]]\+\)\?TPM2_KIRA_PIN=' "$file" || continue

        # mkinitcpio sources this file itself, as root, so reading it here
        # crosses no boundary it has not already crossed.
        local pin
        pin=$(set +u; . "$file" > /dev/null 2>&1; printf '%s' "${TPM2_KIRA_PIN:-}")
        [[ -n $pin ]] || continue

        local mode
        mode=$(stat -c '%a' "$file" 2>/dev/null)
        if [[ -n $mode && ${mode: -2} != "00" ]]; then
            echo "tpm2-kira: WARNING — $file holds a YubiKey PIN and is mode $mode," >&2
            echo "tpm2-kira:   which lets other local users read it. Fix with: chmod 600 $file" >&2
        fi

        export TPM2_KIRA_PIN="$pin"
        return 0
    done

    return 0
}

_load_pin

# tpm2-kira exits 0 even on failure, by design, so that chained commands still
# run. Success must therefore be judged from the output, not the exit status.
output=$(tpm2-kira reseal --measure-point="$measure_point" 2>&1)
unset TPM2_KIRA_PIN

if grep -q "Successfully resealed" <<< "$output"; then
    echo "tpm2-kira: reseal completed successfully (measure-point=$measure_point)"
elif grep -q "tpm2-kira: SKIPPED:" <<< "$output"; then
    # Not a failure: nothing was changed and the sealed secret is intact. It
    # does mean the next boot shows a PCR mismatch and no code, which the user
    # has to know about before they see it and think the worst.
    echo "" >&2
    echo "  ┌────────────────────────────────────────────────────────────────────┐" >&2
    echo "  │ tpm2-kira: NOT RESEALED — the next boot will show a PCR MISMATCH   │" >&2
    echo "  │            and no TOTP code. This is expected, not a compromise.   │" >&2
    echo "  └────────────────────────────────────────────────────────────────────┘" >&2
    echo "$output" >&2
    echo "" >&2
elif grep -q "has not been configured yet" <<< "$output"; then
    # Signing keys exist but no secret has been sealed. Expected between
    # 'tpm2-kira setup' and 'tpm2-kira seal', and not worth a warning.
    echo "tpm2-kira: no sealed secret yet; run 'tpm2-kira seal' to create one"
else
    echo "tpm2-kira: WARNING — reseal did NOT succeed:" >&2
    echo "$output" >&2
    echo "tpm2-kira: the next boot will not be able to unseal; run 'tpm2-kira reseal' manually" >&2
    # Do not fail the overall mkinitcpio run; the image was already written.
fi

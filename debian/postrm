#!/bin/sh
set -e

case "$1" in
remove)
    # The hook and boot script are gone by now; rebuild so the image drops them.
    if command -v update-initramfs >/dev/null 2>&1; then
        update-initramfs -u
    fi
    ;;
purge)
    # /etc/tpm2-kira/keys and the sealed NVRAM blob are left in place on
    # purge: deleting the signing key destroys the only recovery path for a
    # secret that may still be sealed in the TPM.
    if [ -d /etc/tpm2-kira/keys ]; then
        echo "tpm2-kira: keeping /etc/tpm2-kira/keys (signing keys)." >&2
        echo "tpm2-kira: 'tpm2-kira slot delete' before removing the package takes" >&2
        echo "tpm2-kira: everything of it from the TPM and the EFI variables (the slots," >&2
        echo "tpm2-kira: the boot settings, the SSH CA); then remove the keys by hand." >&2
    fi
    ;;
esac

#DEBHELPER#

exit 0
